cff-version: 1.2.0
message: "If you use dfm-python, please cite it using the metadata from this file."
type: software
title: dfm-python
abstract: >-
  Dynamic factor models in Python with one scikit-learn-style estimator API:
  a linear, mixed-frequency dynamic factor model estimated by EM with an exact
  Kalman filter and smoother (DFM), a deep dynamic factor model (DDFM), an
  identifiable variational dynamic factor model (iVDFM) and the Attention
  Factor Model for statistical arbitrage (AFM).
authors:
  - given-names: Minkey
    family-names: Chang
version: 0.8.1
date-released: "2026-10-20"
license: MIT
repository-code: "https://github.com/minkeymouse/dfm-python"
url: "https://pypi.org/project/dfm-python/"
keywords:
  - dynamic factor model
  - mixed frequency
  - Kalman filter
  - EM algorithm
  - forecasting
  - time series
  - econometrics
  - deep learning
references:
  - type: article
    title: >-
      Conditionally Identifiable Latent Representation for Multivariate Time
      Series with Structural Dynamics
    authors:
      - given-names: Minkey
        family-names: Chang
      - given-names: Jae-Young
        family-names: Kim
    year: 2026
    repository: "https://arxiv.org/abs/2603.22886"
    identifiers:
      - type: other
        value: "arXiv:2603.22886"
        description: arXiv identifier
    notes: Introduces iVDFM; dfm-python is its reference implementation.
  - type: conference-paper
    title: >-
      Amortized Neural Filtering for Calibrated Posteriors in Statistical
      Arbitrage
    authors:
      - given-names: Minkey
        family-names: Chang
    year: 2026
    conference:
